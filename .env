# ============================================================
# Madrasha ERP SaaS — Environment Configuration
# ============================================================

# Database (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# For local development:
DATABASE_URL=postgresql://madrasha_user:madrasha_pass@localhost:5432/madrasha_erp
# For production, override with your actual PostgreSQL credentials

# NextAuth
NEXTAUTH_SECRET=change-this-to-a-random-secret-in-production
NEXTAUTH_URL=http://localhost:3000
