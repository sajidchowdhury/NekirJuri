# ============================================================
# Madrasha ERP SaaS — .dockerignore
# Files excluded from Docker build context
# ============================================================

# Dependencies (installed inside container)
node_modules

# Next.js build (rebuilt inside container)
.next
out

# Debug & logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
dev.log
dev.out.log
server.log

# Environment files (secrets must NOT be baked into image)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.production

# IDE
.vscode
.idea
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Git
.git
.gitignore

# AI / Config
.claude
.z-ai-config

# Test / Coverage
coverage
test
tests
prompt
vitest.config.ts

# Skills (not needed in production)
skills

# Upload / Download directories
upload
download

# Dev-only files
Caddyfile
worklog.md
PRODUCTION_ROADMAP.md
DEPT_*.md
UI-UX-ROADMAP.md
examples

# Docker files (prevent recursion)
Dockerfile
docker-compose.yml
.dockerignore

# Misc build artifacts
*.tgz
*.tar.gz
