# ============================================================
# Madrasha ERP SaaS — PRODUCTION Environment
# ============================================================
# This file is used by `scripts/switch-to-prod.sh` to configure
# the production environment. Copy to .env when deploying.
#
# IMPORTANT: Never commit this file with real secrets!
# Use .env.production.local for actual credentials.
# ============================================================

# --- DATABASE (PostgreSQL) ---
# REQUIRED: Your PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://madrasha_user:CHANGE_ME@localhost:5432/madrasha_erp?schema=public

# --- NEXTAUTH (Authentication) ---
# REQUIRED: A cryptographically random secret for signing JWTs
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET

# The public URL of your deployed application
NEXTAUTH_URL=https://your-domain.com

# --- APPLICATION ---
NODE_ENV=production
PORT=3000

# --- SMTP / EMAIL ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM="Madrasha ERP <noreply@your-domain.com>"

# --- SMS PROVIDER ---
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=your-account-sid
# TWILIO_AUTH_TOKEN=your-auth-token
# TWILIO_PHONE_NUMBER=+1234567890

# --- SUBSCRIPTION PAYMENT ---
# BKASH_USERNAME=your-bkash-username
# BKASH_PASSWORD=your-bkash-password
# BKASH_APP_KEY=your-bkash-app-key
# BKASH_APP_SECRET=your-bkash-app-secret

# --- BACKUP ---
# BACKUP_STORAGE_LOCAL=true
# BACKUP_S3_BUCKET=your-backup-bucket
# BACKUP_S3_REGION=ap-south-1
# BACKUP_S3_ACCESS_KEY=your-access-key
# BACKUP_S3_SECRET_KEY=your-secret-key

# --- CRON JOBS ---
# CRON_DONATION_PORT=3031
# CRON_BACKUP_PORT=3032

# --- LOGGING ---
LOG_LEVEL=warn

# --- DOCKER / POSTGRESQL ---
# Used by docker-compose.yml
POSTGRES_USER=madrasha_user
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=madrasha_erp
POSTGRES_PORT=5432

# --- CORS ---
# Comma-separated list of allowed origins (leave empty for same-origin only)
# CORS_ORIGINS=https://your-frontend.com
