  products Product[]

  @@index([tenantId])
  @@map("product_categories")
}

model Product {
  id             Int       @id @default(autoincrement())
  tenantId       Int       @map("tenant_id")
  name           String
  code           String
  categoryId     Int       @map("category_id")
  description    String?
  unit           String?
  purchasePrice  Decimal     @default(0) @map("purchase_price")
  salePrice      Decimal     @default(0) @map("sale_price")
  currentStock   Decimal     @default(0) @map("current_stock")
  minStockLevel  Decimal     @default(0) @map("min_stock_level")
  maxStockLevel  Decimal?    @map("max_stock_level")
  isActive       Boolean   @default(true) @map("is_active")
  hasExpiry      Boolean   @default(false) @map("has_expiry")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")
  createdBy      Int?      @map("created_by")
  updatedBy      Int?      @map("updated_by")

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category       ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  purchaseItems  PurchaseItem[]
  stockMovements StockMovement[]
  salesItems     SalesItem[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, categoryId])
  @@map("products")
}

model Purchase {
  id             Int      @id @default(autoincrement())
  tenantId       Int      @map("tenant_id")
