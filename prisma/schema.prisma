// ============================================================
// Madrasha ERP & Accounting Management System (SaaS)
// Database Schema — Prisma (Dual Environment)
// Dev: SQLite  |  Production: PostgreSQL
// Version: 2.0
// ============================================================
// Environment Switch:
//   Dev:  bun run db:dev       (switches to SQLite)
//   Prod: bun run db:prod      (switches to PostgreSQL)
//   The schema types (Decimal, Json) work with BOTH databases
// ============================================================
// Design Principles:
//   - Multi-tenant: tenant_id on every business table
//   - Composite unique constraints prevent cross-tenant data leaks
//   - Soft delete (deleted_at) on transactional entities
//   - Audit fields: created_at, updated_at, created_by, updated_by
//   - Double-entry accounting foundation (chart_of_accounts, journal_entries)
//   - Index strategy optimized for reporting queries
//   - snake_case table names via @@map
//   - Singular table names for consistency
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// DOMAIN 1: SAAS — Tenants, Subscriptions, Billing
// ============================================================

model Tenant {
  id          Int      @id @default(autoincrement())
  uuid        String   @unique @default(cuid())
  name        String
  slug        String   @unique
  domain      String?  @unique
  logoUrl     String?  @map("logo_url")
  address     String?
  city        String?
  state       String?
  country     String   @default("Bangladesh")
  postalCode  String?  @map("postal_code")
  phone       String?
  email       String?
  website     String?
  isActive           Boolean  @default(true) @map("is_active")
  settings           Json?
  subscriptionStatus String   @default("active") @map("subscription_status") // Cached: trial | active | grace_period | restricted | suspended | terminated | cancelled
  isReadOnly         Boolean  @default(false) @map("is_read_only") // Cached: true when enforcement is readonly/restricted/blocked
  storageUsedMb      Decimal  @default(0) @map("storage_used_mb")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  subscriptions      Subscription[]
  subscriptionPayments SubscriptionPayment[]
  users              User[]
  roles              Role[]
  academicSessions   AcademicSession[]
  classes            Class[]
  sections           Section[]
  students           Student[]
  guardians          Guardian[]
  teachers           Teacher[]
  employees          Employee[]
  studentPromotions  StudentPromotion[]
  feeCategories      FeeCategory[]
  feeStructures      FeeStructure[]
  feeInvoices        FeeInvoice[]
  feeInvoiceItems    FeeInvoiceItem[]
  feeCollections     FeeCollection[]
  feeDiscounts       FeeDiscount[]
  donationCategories DonationCategory[]
  donors             Donor[]
  donations          Donation[]
  expenseCategories  ExpenseCategory[]
  expenses           Expense[]
  salaryStructures   SalaryStructure[]
  salaryPayments     SalaryPayment[]
  suppliers          Supplier[]
  productCategories  ProductCategory[]
  products           Product[]
  purchases          Purchase[]
  purchaseItems      PurchaseItem[]
  stockMovements     StockMovement[]
  salesInvoices      SalesInvoice[]
  salesItems         SalesItem[]
  chartOfAccounts    ChartOfAccount[]
  journalEntries     JournalEntry[]
  journalEntryItems  JournalEntryItem[]
  websitePages       WebsitePage[]
  notices            Notice[]
  galleries          Gallery[]
  galleryImages      GalleryImage[]
  settingsEntries    Settings[]
  notifications      Notification[]
  activityLogs       ActivityLog[]
  auditLogs          AuditLog[]

  @@map("tenants")
}

model SubscriptionPlan {
  id            Int      @id @default(autoincrement())
  name          String
  slug          String   @unique
  description   String?
  priceMonthly  Decimal  @map("price_monthly")
  price6Monthly Decimal? @map("price_6_monthly")
  priceYearly   Decimal? @map("price_yearly")
  maxStudents      Int      @map("max_students")
  maxEmployees     Int      @map("max_employees")
  maxStorageMb     Int      @map("max_storage_mb")
  maxAlbums        Int      @default(5) @map("max_albums")
  maxImagesPerAlbum Int     @default(20) @map("max_images_per_album")
  maxImageSizeMb   Int      @default(2) @map("max_image_size_mb")
  features         Json?
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  subscriptions Subscription[]

  @@map("subscription_plans")
}

model Subscription {
  id                Int      @id @default(autoincrement())
  tenantId          Int      @map("tenant_id")
  planId            Int      @map("plan_id")
  status            String   // trial | active | grace_period | restricted | suspended | terminated | cancelled
  billingDuration   Int      @default(1) @map("billing_duration") // 1, 6, or 12 months
  paymentMethod     String?  @map("payment_method") // bkash | nagad | bank | manual
  startDate         DateTime @map("start_date")
  endDate           DateTime @map("end_date")
  currentPeriodEnd  DateTime @default(now()) @map("current_period_end") // Exact end of current billing period (defaults to now for existing rows, updated on next payment)
  gracePeriodEnd    DateTime? @map("grace_period_end") // When grace period ends (endDate + 14 days)
  restrictedEnd     DateTime? @map("restricted_end") // When restricted period ends before suspension
  trialEnd          DateTime? @map("trial_end")
  isAutoRenew       Boolean  @default(false) @map("is_auto_renew")
  lastPaymentDate   DateTime? @map("last_payment_date") // Date of most recent successful payment
  lastPaymentMethod String?   @map("last_payment_method") // bkash | nagad | bank | manual — from most recent payment
  lastPaymentRef    String?   @map("last_payment_ref") // Transaction ref from most recent payment
  dataDeletionDate  DateTime? @map("data_deletion_date") // When business data will be deleted (terminated + 30 days)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  tenant   Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan     SubscriptionPlan    @relation(fields: [planId], references: [id])
  payments SubscriptionPayment[]

  @@index([tenantId])
  @@index([status])
  @@index([tenantId, status, currentPeriodEnd])
  @@map("subscriptions")
}

model SubscriptionPayment {
  id             Int      @id @default(autoincrement())
  subscriptionId Int      @map("subscription_id")
  tenantId       Int      @map("tenant_id")
  amount         Decimal
  currency       String   @default("BDT")
  paymentMethod  String   @map("payment_method") // bkash | nagad | bank | manual
  paymentRef     String?  @map("payment_ref") // Transaction ID from bKash/Nagad
  paymentPhone   String?  @map("payment_phone") // Phone number used for payment
  status         String   // pending | verified | failed | refunded
  billingPeriod  String   @map("billing_period") // e.g. "2025-01", "2025-H1", "2025"
  duration       Int      // 1, 6, or 12 months
  paidAt         DateTime? @map("paid_at")
  verifiedAt     DateTime? @map("verified_at")
  verifiedBy     Int?     @map("verified_by") // Admin who verified manual payment
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([tenantId])
  @@index([status])
  @@index([paymentRef])
  @@map("subscription_payments")
}

// ============================================================
// DOMAIN 2: SECURITY — Users, Roles, Permissions, RBAC
// ============================================================

model User {
  id           Int       @id @default(autoincrement())
  uuid         String    @unique @default(cuid())
  tenantId     Int?      @map("tenant_id")
  email        String
  passwordHash String    @map("password_hash")
  name         String
  phone        String?
  avatarUrl    String?   @map("avatar_url")
  isActive      Boolean   @default(true) @map("is_active")
  isSuperAdmin  Boolean   @default(false) @map("is_super_admin")
  emailVerified Boolean   @default(false) @map("email_verified") // Has user verified their email via OTP?
  lastLoginAt   DateTime? @map("last_login_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  tenant        Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles     UserRole[]
  notifications Notification[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([email])
  @@map("users")
}

model Role {
  id          Int      @id @default(autoincrement())
  tenantId    Int      @map("tenant_id")
  name        String
  slug        String
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("roles")
}

model Permission {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  module      String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  id           Int      @id @default(autoincrement())
  roleId       Int      @map("role_id")
  permissionId Int      @map("permission_id")
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  roleId    Int      @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

// ============================================================
// DOMAIN 3: ACADEMIC — Sessions, Classes, Sections, Students,
//            Guardians, Teachers, Employees, Promotions
// ============================================================

model AcademicSession {
  id        Int      @id @default(autoincrement())
  tenantId  Int      @map("tenant_id")
  name      String
  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")
  isCurrent Boolean  @default(false) @map("is_current")
  status    String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classes           Class[]
  students          Student[]
  feeStructures     FeeStructure[]
  feeInvoices       FeeInvoice[]
  studentPromotions StudentPromotion[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, status])
  @@map("academic_sessions")
}

model Class {
  id                Int      @id @default(autoincrement())
  tenantId          Int      @map("tenant_id")
  name              String
  code              String
  orderSequence     Int      @map("order_sequence")
  academicSessionId Int      @map("academic_session_id")
  teacherId         Int?     @map("teacher_id")
  capacity          Int?
  description       String?
  status            String
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  tenant             Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicSession    AcademicSession @relation(fields: [academicSessionId], references: [id], onDelete: Cascade)
  classTeacher       Teacher?        @relation("ClassTeacher", fields: [teacherId], references: [id])
  sections           Section[]
  students           Student[]
  feeStructures      FeeStructure[]
  feeInvoices        FeeInvoice[]
  promotionsFromClass StudentPromotion[] @relation("PromotionFromClass")
  promotionsToClass   StudentPromotion[] @relation("PromotionToClass")

  @@unique([tenantId, code, academicSessionId])
  @@index([tenantId])
  @@index([tenantId, academicSessionId])
  @@map("classes")
}

model Section {
  id        Int      @id @default(autoincrement())
  tenantId  Int      @map("tenant_id")
  classId   Int      @map("class_id")
  name      String
  teacherId Int?     @map("teacher_id")
  capacity  Int?
  status    String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant          Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  class           Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  sectionInCharge Teacher? @relation("SectionInCharge", fields: [teacherId], references: [id])
  students        Student[]

  @@unique([tenantId, classId, name])
  @@index([tenantId])
  @@index([tenantId, classId])
  @@map("sections")
}

model Student {
  id                Int       @id @default(autoincrement())
  tenantId          Int       @map("tenant_id")
  uuid              String    @unique @default(cuid())
  registrationNo    String    @map("registration_no")
  admissionNo       String?   @map("admission_no")
  name              String
  nameBn            String?   @map("name_bn")
  fatherName        String?   @map("father_name")
  motherName        String?   @map("mother_name")
  dateOfBirth       DateTime? @map("date_of_birth")
  gender            String?
  bloodGroup        String?   @map("blood_group")
  nationality       String?   @default("Bangladeshi")
  religion          String?
  photoUrl          String?   @map("photo_url")
  phone             String?
  email             String?
  address           String?
  city              String?
  state             String?
  country           String?
  postalCode        String?   @map("postal_code")
  classId           Int       @map("class_id")
  sectionId         Int?      @map("section_id")
  academicSessionId Int       @map("academic_session_id")
  admissionDate     DateTime? @map("admission_date")
  previousSchool    String?   @map("previous_school")
  rollNo            String?   @map("roll_no")
  isActive          Boolean   @default(true) @map("is_active")
  status            String
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")
  createdBy         Int?      @map("created_by")
  updatedBy         Int?      @map("updated_by")

  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  class            Class            @relation(fields: [classId], references: [id], onDelete: Restrict)
  section          Section?         @relation(fields: [sectionId], references: [id])
  academicSession  AcademicSession  @relation(fields: [academicSessionId], references: [id], onDelete: Restrict)
  studentGuardians StudentGuardian[]
  feeInvoices      FeeInvoice[]
  feeCollections   FeeCollection[]
  feeDiscounts     FeeDiscount[]
  studentPromotions StudentPromotion[]
  salesInvoices    SalesInvoice[]

  @@unique([tenantId, registrationNo])
  @@index([tenantId])
  @@index([tenantId, classId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([registrationNo])
  @@map("students")
}

model Guardian {
  id           Int       @id @default(autoincrement())
  tenantId     Int       @map("tenant_id")
  uuid         String    @unique @default(cuid())
  name         String
  nameBn       String?   @map("name_bn")
  relationship String
  phone        String
  phoneAlt     String?   @map("phone_alt")
  email        String?
  occupation   String?
  address      String?
  city         String?
  photoUrl     String?   @map("photo_url")
  nidNo        String?   @map("nid_no")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentGuardians StudentGuardian[]

  @@index([tenantId])
  @@index([phone])
  @@map("guardians")
}

model StudentGuardian {
  id         Int      @id @default(autoincrement())
  studentId  Int      @map("student_id")
  guardianId Int      @map("guardian_id")
  isPrimary  Boolean  @default(false) @map("is_primary")
  createdAt  DateTime @default(now()) @map("created_at")

  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@unique([studentId, guardianId])
  @@map("student_guardians")
}

model Teacher {
  id             Int       @id @default(autoincrement())
  tenantId       Int       @map("tenant_id")
  uuid           String    @unique @default(cuid())
  employeeIdNo   String    @map("employee_id_no")
  name           String
  nameBn         String?   @map("name_bn")
  fatherName     String?   @map("father_name")
  motherName     String?   @map("mother_name")
  dateOfBirth    DateTime? @map("date_of_birth")
  gender         String?
  bloodGroup     String?   @map("blood_group")
  nationality    String?
  religion       String?
  photoUrl       String?   @map("photo_url")
  phone          String
  email          String?
  address        String?
  city           String?
  qualification  String?
  specialization String?
  joiningDate    DateTime? @map("joining_date")
  leavingDate    DateTime? @map("leaving_date")
  isActive       Boolean   @default(true) @map("is_active")
  status         String
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")
  createdBy      Int?      @map("created_by")
  updatedBy      Int?      @map("updated_by")

  tenant               Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classesAsTeacher     Class[]           @relation("ClassTeacher")
  sectionsAsInCharge   Section[]         @relation("SectionInCharge")
  salaryStructures     SalaryStructure[] @relation("TeacherSalary")
  salaryPayments       SalaryPayment[]   @relation("TeacherSalaryPayment")

  @@unique([tenantId, employeeIdNo])
  @@index([tenantId])
  @@index([tenantId, status])
  @@map("teachers")
}

model Employee {
  id           Int       @id @default(autoincrement())
  tenantId     Int       @map("tenant_id")
  uuid         String    @unique @default(cuid())
  employeeIdNo String    @map("employee_id_no")
  name         String
  nameBn       String?   @map("name_bn")
  fatherName   String?   @map("father_name")
  dateOfBirth  DateTime? @map("date_of_birth")
  gender       String?
  phone        String
  email        String?
  address      String?
  designation  String?
  department   String?
  joiningDate  DateTime? @map("joining_date")
  leavingDate  DateTime? @map("leaving_date")
  photoUrl     String?   @map("photo_url")
  isActive     Boolean   @default(true) @map("is_active")
  status       String
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")
  createdBy    Int?      @map("created_by")
  updatedBy    Int?      @map("updated_by")

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  salaryStructures SalaryStructure[] @relation("EmployeeSalary")
  salaryPayments   SalaryPayment[]   @relation("EmployeeSalaryPayment")

  @@unique([tenantId, employeeIdNo])
  @@index([tenantId])
  @@index([tenantId, status])
  @@map("employees")
}

model StudentPromotion {
  id                Int      @id @default(autoincrement())
  tenantId          Int      @map("tenant_id")
  studentId         Int      @map("student_id")
  fromClassId       Int      @map("from_class_id")
  fromSectionId     Int?     @map("from_section_id")
  toClassId         Int      @map("to_class_id")
  toSectionId       Int?     @map("to_section_id")
  academicSessionId Int      @map("academic_session_id")
  promotionType     String   @map("promotion_type")
  remarks           String?
  promotedBy        Int?     @map("promoted_by")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student         Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fromClass       Class           @relation("PromotionFromClass", fields: [fromClassId], references: [id])
  toClass         Class           @relation("PromotionToClass", fields: [toClassId], references: [id])
  academicSession AcademicSession @relation(fields: [academicSessionId], references: [id])

  @@index([tenantId])
  @@index([studentId])
  @@index([academicSessionId])
  @@map("student_promotions")
}

// ============================================================
// DOMAIN 4: FINANCE — Fees, Donations, Expenses, Salary, Accounting
// ============================================================

// --- FEE MANAGEMENT ---

model FeeCategory {
  id          Int      @id @default(autoincrement())
  tenantId    Int      @map("tenant_id")
  name        String
  code        String
  description String?
  amount      Decimal
  isRecurring Boolean  @default(false) @map("is_recurring")
  frequency   String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  feeStructures FeeStructure[]
  invoiceItems  FeeInvoiceItem[]
  feeDiscounts  FeeDiscount[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("fee_categories")
}

model FeeStructure {
  id                Int      @id @default(autoincrement())
  tenantId          Int      @map("tenant_id")
  classId           Int      @map("class_id")
  feeCategoryId     Int      @map("fee_category_id")
  academicSessionId Int      @map("academic_session_id")
  amount            Decimal
  isMandatory       Boolean  @default(true) @map("is_mandatory")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  class           Class           @relation(fields: [classId], references: [id], onDelete: Cascade)
  feeCategory     FeeCategory     @relation(fields: [feeCategoryId], references: [id], onDelete: Cascade)
  academicSession AcademicSession @relation(fields: [academicSessionId], references: [id], onDelete: Cascade)

  @@unique([tenantId, classId, feeCategoryId, academicSessionId])
  @@index([tenantId])
  @@index([tenantId, classId])
  @@map("fee_structures")
}

model FeeInvoice {
  id                Int       @id @default(autoincrement())
  tenantId          Int       @map("tenant_id")
  invoiceNo         String    @map("invoice_no")
  studentId         Int       @map("student_id")
  academicSessionId Int       @map("academic_session_id")
  classId           Int       @map("class_id")
  issueDate         DateTime  @map("issue_date")
  dueDate           DateTime  @map("due_date")
  totalAmount       Decimal     @map("total_amount")
  paidAmount        Decimal     @default(0) @map("paid_amount")
  discountAmount    Decimal     @default(0) @map("discount_amount")
  fineAmount        Decimal     @default(0) @map("fine_amount")
  balance           Decimal
  status            String
  remarks           String?
  feeMonth          Int?      @map("fee_month")
  feeYear           Int?      @map("fee_year")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")
  createdBy         Int?      @map("created_by")
  updatedBy         Int?      @map("updated_by")

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student         Student         @relation(fields: [studentId], references: [id], onDelete: Restrict)
  academicSession AcademicSession @relation(fields: [academicSessionId], references: [id])
  class           Class           @relation(fields: [classId], references: [id])
  invoiceItems    FeeInvoiceItem[]
  feeCollections  FeeCollection[]
  feeDiscounts    FeeDiscount[]
  salesInvoices   SalesInvoice[]

  @@unique([tenantId, invoiceNo])
  @@index([tenantId])
