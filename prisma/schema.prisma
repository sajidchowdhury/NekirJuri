  @@unique([tenantId, receiptNo])
  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([donationCategoryId])
  @@index([tenantId, isRecurring])
  @@index([nextDueDate])
  @@map("donations")
}

