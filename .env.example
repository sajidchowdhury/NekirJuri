# ============================================================
# Madrasha ERP SaaS — Environment Configuration
# ============================================================
# This project supports DUAL database environments:
#   - Development: SQLite (file-based, no server needed)
#   - Production:  PostgreSQL (scalable, concurrent)
#
# Copy this file to .env and fill in the values.
# The Prisma schema types (Decimal, Json) work with BOTH.
# ============================================================

# --- DATABASE ---
# Development (SQLite) — used by: Z.ai preview, local development
DATABASE_URL=file:./db/madrasha.db

# Production (PostgreSQL) — uncomment and fill in your credentials
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# DATABASE_URL=postgresql://madrasha_user:your_secure_password@localhost:5432/madrasha_erp?schema=public

# --- NEXTAUTH (Authentication) ---
# REQUIRED: A random secret for signing JWTs (min 32 chars)
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=change-this-to-a-random-secret-in-production

# The base URL of your app (used for callback URLs)
# Development:  http://localhost:3000
# Production:   https://your-domain.com
NEXTAUTH_URL=http://localhost:3000

# --- APPLICATION ---
# Node environment: development | production | test
NODE_ENV=development

# App port (default: 3000)
PORT=3000

# --- SMTP / EMAIL (Optional — Phase 3) ---
# Used for sending notification emails (fee reminders, etc.)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM="Madrasha ERP <noreply@your-domain.com>"

# --- SMS PROVIDER (Optional — Phase 3) ---
# Used for sending SMS notifications
# SMS_PROVIDER=twilio        # twilio | msg91 | bulk-sms-bd
# TWILIO_ACCOUNT_SID=your-account-sid
# TWILIO_AUTH_TOKEN=your-auth-token
# TWILIO_PHONE_NUMBER=+1234567890
# MSG91_API_KEY=your-msg91-key
# MSG91_SENDER_ID=MADRSHP

# --- SUBSCRIPTION PAYMENT (Optional) ---
# bKash / Nagad payment gateway credentials
# BKASH_USERNAME=your-bkash-username
# BKASH_PASSWORD=your-bkash-password
# BKASH_APP_KEY=your-bkash-app-key
# BKASH_APP_SECRET=your-bkash-app-secret
# NAGAD_MOBILE_NUMBER=your-nagad-number
# NAGAD_PASSWORD=your-nagad-password

# --- BACKUP (Optional) ---
# Backup storage configuration
# BACKUP_STORAGE_LOCAL=true                    # Store backups locally (default)
# BACKUP_STORAGE_S3=false                      # Store backups in S3
# BACKUP_S3_BUCKET=your-backup-bucket
# BACKUP_S3_REGION=ap-south-1
# BACKUP_S3_ACCESS_KEY=your-access-key
# BACKUP_S3_SECRET_KEY=your-secret-key

# --- CRON JOBS ---
# Donation reminder cron port (default: 3031)
# CRON_DONATION_PORT=3031
# Backup cron port (default: 3032)
# CRON_BACKUP_PORT=3032

# --- LOGGING ---
# Log level: debug | info | warn | error
# LOG_LEVEL=info

# --- DOCKER / POSTGRESQL ---
# These are used by docker-compose.yml for the PostgreSQL service
# POSTGRES_USER=madrasha_user
# POSTGRES_PASSWORD=your_secure_password
# POSTGRES_DB=madrasha_erp
# POSTGRES_PORT=5432

# --- CORS (Optional) ---
# Comma-separated list of allowed origins for API requests
# Leave empty to allow same-origin only (recommended)
# CORS_ORIGINS=https://your-frontend.com,https://admin.your-domain.com
