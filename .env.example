# ============================================================
# Madrasha ERP SaaS — Environment Configuration
# ============================================================
# This project supports DUAL database environments:
#   - Development: SQLite (file-based, no server needed)
#   - Production:  PostgreSQL (scalable, concurrent)
#
# The Prisma schema types (Decimal, Json) work with BOTH.
# ============================================================

# --- DEVELOPMENT (SQLite) ---
# Used by: Z.ai preview, local development
DATABASE_URL=file:./db/madrasha.db

# --- PRODUCTION (PostgreSQL) ---
# Used by: Your deployment server
# Uncomment and fill in your PostgreSQL credentials:
# DATABASE_URL=postgresql://madrasha_user:madrasha_pass@localhost:5432/madrasha_erp

# NextAuth
NEXTAUTH_SECRET=change-this-to-a-random-secret-in-production
NEXTAUTH_URL=http://localhost:3000
